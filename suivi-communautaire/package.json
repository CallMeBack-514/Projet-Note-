{
  "name": "suivi-communautaire",
  "version": "1.0.0",
  "description": "Dossiers communautaires — Workers et D1",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build && tsc --noEmit",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "cf d1 migrations apply 7e246701-f720-4ed4-9a21-3b5811778d30 --local --persist-to .cloudflare/state --dir migrations",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/provision.mjs",
    "demo:setup": "npm run setup && npm run db:migrate && npm run demo",
    "test:browser": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-auth": "1.7.10",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.18",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "private": true
}
